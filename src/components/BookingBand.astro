---
interface Props {
  salon: {
    phone: string;
  };
  booking: {
    provider: string;
    url: string;
    embedUrl: string;
    mode: "link" | "embed";
  };
  title?: string;
  text?: string;
}

const {
  salon,
  booking,
  title = "Bereit fuer deinen naechsten Termin?",
  text = "Buche online oder ruf direkt im Salon an. In einem echten Kundenprojekt fuehrt der Button zum gewaehlten Booking-System.",
} = Astro.props;
---

<section class="booking-band">
  <div class="container booking-inner">
    <div>
      <p class="eyebrow">Termin</p>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="booking-actions">
      <a class="btn btn-primary" href="/termin/">Termin buchen</a>
      <a class="btn btn-secondary booking-phone" href={"tel:" + salon.phone.replaceAll(" ", "")}>{salon.phone}</a>
    </div>
    {
      booking.mode === "embed" && booking.embedUrl ? (
        <iframe
          class="booking-frame"
          src={booking.embedUrl}
          title={booking.provider + " Terminbuchung"}
          loading="lazy"
        />
      ) : null
    }
  </div>
</section>

<style>
  .booking-band {
    background: var(--dark);
    color: var(--ink-on-dark);
    padding: 56px 0;
  }

  .booking-band .eyebrow {
    color: var(--gold);
  }

  .booking-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
  }

  h2 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.1;
  }

  p {
    max-width: 650px;
    color: var(--muted-on-dark);
    line-height: 1.6;
  }

  .booking-actions {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    gap: 12px;
  }

  .booking-phone {
    border-color: var(--dark-line);
    background: rgba(255, 255, 255, 0.05);
    color: var(--ink-on-dark);
  }

  .booking-phone:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .booking-frame {
    grid-column: 1 / -1;
    width: 100%;
    min-height: 620px;
    border: 1px solid var(--dark-line);
    border-radius: 6px;
    background: #fff;
  }

  @media (max-width: 820px) {
    .booking-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
