---
import { salon } from "../data/salon";

interface Props {
  title?: string;
  text?: string;
}

const {
  title = "Bereit fuer deinen naechsten Termin?",
  text = "Buche online oder ruf direkt im Salon an. In einem echten Kundenprojekt fuehrt der Button zum gewaehlteten Booking-System.",
} = Astro.props;
---

<section class="booking-band">
  <div class="container booking-inner">
    <div>
      <p class="eyebrow">Termin</p>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="booking-actions">
      <a class="btn btn-primary" href={salon.bookingUrl}>Termin buchen</a>
      <a class="btn btn-secondary" href={`tel:${salon.phone.replaceAll(" ", "")}`}>{salon.phone}</a>
    </div>
  </div>
</section>

<style>
  .booking-band {
    background: #efe7db;
    padding: 46px 0;
  }

  .booking-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  h2 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 3rem);
    line-height: 1;
  }

  p {
    max-width: 650px;
    color: var(--muted);
    line-height: 1.6;
  }

  .booking-actions {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 820px) {
    .booking-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
