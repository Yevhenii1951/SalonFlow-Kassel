---
interface Props {
  salon: {
    name: string;
  };
  bookingUrl: string;
}

const { salon, bookingUrl } = Astro.props;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Friseur in Kassel Mitte</p>
      <h1 class="h1">Modernes Haarstudio fuer Farbe und Schnitt.</h1>
      <p class="lead">
        {salon.name} ist ein fiktives Portfolio-Projekt fuer einen lokalen Salon:
        schnelle Buchung, klare Leistungen und starke lokale Auffindbarkeit.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={bookingUrl}>Termin buchen</a>
        <a class="btn btn-secondary hero-secondary" href="/leistungen/">Leistungen ansehen</a>
      </div>
    </div>
    <figure class="hero-media">
      <img
        src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=1400&q=82"
        alt="Barbershop im dunklen Prestige-Stil mit Ledersesseln"
        loading="eager"
      />
      <figcaption>
        <strong>Heute freie Beratungsslots</strong>
        <span>Balayage, Schnitt, Styling</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 74px);
    padding: 56px 0 62px;
    background: var(--dark);
    color: var(--ink-on-dark);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(320px, 0.94fr);
    gap: 40px;
    align-items: center;
  }

  .hero-copy {
    padding: 34px 0;
  }

  .hero-copy .eyebrow {
    color: var(--gold);
  }

  .hero-copy .lead {
    color: var(--muted-on-dark);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .hero-secondary {
    border-color: var(--dark-line);
    background: rgba(255, 255, 255, 0.05);
    color: var(--ink-on-dark);
  }

  .hero-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .hero-media {
    position: relative;
    min-height: 600px;
    overflow: hidden;
    border-radius: 6px;
    margin: 0;
    background: var(--dark-surface);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55);
  }

  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(18, 16, 13, 0.25), rgba(18, 16, 13, 0.55));
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    min-height: 600px;
    object-fit: cover;
  }

  figcaption {
    position: absolute;
    right: 18px;
    bottom: 18px;
    left: 18px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border: 1px solid var(--dark-line);
    border-radius: 6px;
    background: rgba(18, 16, 13, 0.72);
    color: var(--ink-on-dark);
    padding: 16px 18px;
    backdrop-filter: blur(16px);
  }

  figcaption span {
    color: var(--muted-on-dark);
  }

  @media (max-width: 920px) {
    .hero {
      min-height: auto;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-media,
    .hero-media img {
      min-height: 420px;
    }
  }

  @media (max-width: 620px) {
    figcaption {
      display: block;
    }
  }
</style>
