---
interface Props {
  salon: {
    name: string;
  };
  bookingUrl: string;
}

const { salon, bookingUrl } = Astro.props;
---

<section class="hero">
  <div class="hero-media" aria-hidden="true">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/videos/hero-poster.jpg"
      aria-label="Hintergrundvideo aus dem Frisiersalon"
    >
      <source src="/videos/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade"></div>
  </div>

  <div class="hero-inner container">
    <div class="hero-content">
      <p class="eyebrow">Friseur in Kassel Mitte</p>
      <h1 class="h1">Modernes Haarstudio für Farbe und Schnitt.</h1>
      <p class="lead">
        {salon.name} ist ein fiktives Portfolio-Projekt für einen lokalen Salon:
        schnelle Buchung, klare Leistungen und starke lokale Auffindbarkeit.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={bookingUrl}>Termin buchen</a>
        <a class="btn btn-ghost" href="/leistungen/">Leistungen ansehen</a>
      </div>
    </div>
  </div>

  <div class="hero-footer">
    <div class="hero-footer-inner container">
      <strong>Heute freie Beratungsslots</strong>
      <span>Balayage · Schnitt · Styling</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: calc(100vh - 74px);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--dark);
    color: var(--ink-on-dark);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--dark);
    background-image: url("/videos/hero-poster.jpg");
    background-position: center;
    background-size: cover;
  }

  .hero-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 50% 45%, rgba(18, 16, 13, 0.35), rgba(18, 16, 13, 0) 70%),
      linear-gradient(180deg, rgba(18, 16, 13, 0.5), rgba(18, 16, 13, 0.88));
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    padding-top: 72px;
    padding-bottom: 96px;
  }

  .hero-content {
    max-width: 820px;
    text-align: center;
  }

  .hero-content .eyebrow {
    color: var(--gold);
  }

  .hero-content .h1 {
    max-width: 820px;
    margin-inline: auto;
  }

  .hero-content .lead {
    max-width: 640px;
    margin-inline: auto;
    margin-top: 18px;
    color: var(--muted-on-dark);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
  }

  .btn-ghost {
    border-color: var(--dark-line);
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink-on-dark);
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .hero-footer {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    border-top: 1px solid rgba(245, 239, 228, 0.16);
    background: rgba(18, 16, 13, 0.45);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .hero-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
    font-size: 0.92rem;
  }

  .hero-footer strong {
    font-weight: 700;
  }

  .hero-footer span {
    color: var(--muted-on-dark);
  }

  @media (max-width: 620px) {
    .hero {
      min-height: min(100vh, 700px);
    }

    .hero-inner {
      padding-top: 56px;
      padding-bottom: 86px;
    }

    .hero-footer-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media video {
      display: none;
    }
  }
</style>