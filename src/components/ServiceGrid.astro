---
interface Props {
  services: Array<{
    title: string;
    slug: string;
    summary: string;
    price: string;
    duration: string;
    featured: boolean;
    heroImage?: string;
  }>;
  featuredOnly?: boolean;
}

const { services, featuredOnly = false } = Astro.props;
const visibleServices = featuredOnly ? services.filter((service) => service.featured) : services;
---

<div class="grid-3 service-grid">
  {
    visibleServices.map((service) => (
      <article class="card service-card">
        {
          service.heroImage && (
            <div class="service-image-wrap">
              <img class="service-image" src={service.heroImage} alt="" loading="lazy" />
            </div>
          )
        }
        <div class="service-body">
          <p class="service-meta">{service.duration}</p>
          <h3 class="h3">{service.title}</h3>
          <p>{service.summary}</p>
        </div>
        <div class="service-footer">
          <strong>{service.price}</strong>
          <a href={`/leistungen/${service.slug}/`}>Details</a>
        </div>
      </article>
    ))
  }
</div>

<style>
  .service-card {
    display: flex;
    min-height: 260px;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
  }

  .service-image-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .service-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .service-card:hover .service-image {
    transform: scale(1.05);
    opacity: 1;
  }

  .service-body {
    padding: 24px 24px 0;
  }

  .service-card p {
    color: var(--muted);
    line-height: 1.6;
  }

  .service-meta {
    margin: 0 0 18px;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 780;
  }

  .service-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--line);
    margin: 0 24px;
    padding: 18px 0 24px;
  }

  .service-footer a {
    color: var(--accent);
    font-weight: 760;
    text-decoration: none;
  }
</style>
