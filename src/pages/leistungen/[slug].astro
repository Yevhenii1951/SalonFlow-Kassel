---
import BookingBand from "../../components/BookingBand.astro";
import GalleryGrid from "../../components/GalleryGrid.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBookingIntegration, getGalleryItems, getSalon, getServices } from "../../lib/cms";

export async function getStaticPaths() {
  const services = await getServices();

  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const [salon, gallery] = await Promise.all([getSalon(), getGalleryItems()]);
const booking = getBookingIntegration(salon);
---

<BaseLayout title={service.seoTitle} description={service.seoDescription}>
  <section class="section detail-hero">
    <div class="container detail-grid">
      <div>
        <p class="eyebrow">Leistung in Kassel</p>
        <h1 class="h1">{service.title}</h1>
        <p class="lead">{service.longDescription}</p>
        <div class="facts">
          <span>{service.price}</span>
          <span>{service.duration}</span>
        </div>
        <a class="btn btn-primary" href="/termin/">{service.bookingCtaLabel}</a>
      </div>
      <aside class="card note">
        <strong>SEO-Ziel dieser Seite</strong>
        <p>
          Eine eigene Detailseite kann fuer lokale Suchanfragen wie "{service.title}
          Kassel" ranken und Nutzer direkt zum passenden Termin fuehren.
        </p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container copy-grid">
      <div>
        <p class="eyebrow">Ablauf</p>
        <h2 class="h2">Beratung, Umsetzung, Pflegeempfehlung.</h2>
      </div>
      <div class="steps">
        <article><strong>1. Beratung</strong><p>Haarzustand, Zielbild, Budget und Alltag werden geklaert.</p></article>
        <article><strong>2. Service</strong><p>Die Behandlung wird mit realistischem Zeitfenster umgesetzt.</p></article>
        <article><strong>3. Pflege</strong><p>Der Salon gibt konkrete Empfehlungen fuer Haltbarkeit und Pflege zuhause.</p></article>
      </div>
    </div>
  </section>

  <section class="section gallery-band">
    <div class="container">
      <p class="eyebrow">Eindruck</p>
      <h2 class="h2">Bildsprache fuer Vertrauen und Erwartungsmanagement.</h2>
    </div>
    <div class="container section-tight">
      <GalleryGrid gallery={gallery} />
    </div>
  </section>

  <BookingBand salon={salon} booking={booking} title={service.title + " Termin planen"} />
</BaseLayout>

<style>
  .detail-hero {
    background: var(--dark);
    color: var(--ink-on-dark);
  }

  .detail-hero .eyebrow {
    color: var(--gold);
  }

  .detail-hero .lead {
    color: var(--muted-on-dark);
  }

  .detail-hero .note p {
    color: var(--muted);
  }

  .gallery-band {
    background: #f4efe6;
  }

  .detail-grid,
  .copy-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 34px;
    align-items: start;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0;
  }

  .facts span {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    padding: 10px 14px;
    font-weight: 760;
  }

  .note {
    padding: 24px;
  }

  .note p,
  .steps p {
    color: var(--muted);
    line-height: 1.6;
  }

  .steps {
    display: grid;
    gap: 18px;
  }

  .steps article {
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }

  @media (max-width: 820px) {
    .detail-grid,
    .copy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
