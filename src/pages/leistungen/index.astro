---
import BookingBand from "../../components/BookingBand.astro";
import ServiceGrid from "../../components/ServiceGrid.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBookingIntegration, getSalon, getServices } from "../../lib/cms";

const [salon, services] = await Promise.all([getSalon(), getServices()]);
const booking = getBookingIntegration(salon);
---

<BaseLayout
  title="Leistungen"
  description="Leistungen des fiktiven SalonFlow Kassel: Balayage, Schnitt, Coloration, Pflege und Brautstyling."
>
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">Leistungen</p>
      <h1 class="h1">Alles, was ein lokaler Salon klar verkaufen muss.</h1>
      <p class="lead">
        Jede Leistung ist als Astro Content Collection angelegt. Spaeter kann daraus
        eine CMS Collection in Decap CMS, Sanity, Storyblok oder Directus werden.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <ServiceGrid services={services} />
    </div>
  </section>
  <BookingBand salon={salon} booking={booking} />
</BaseLayout>

<style>
  .page-hero {
    background: #f4efe6;
  }
</style>
