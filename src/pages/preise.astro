---
import BookingBand from "../components/BookingBand.astro";
import PriceCalculator from "../components/PriceCalculator.astro";
import PriceList from "../components/PriceList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getBookingIntegration,
  getPriceGroups,
  getPriceRules,
  getSalon,
} from "../lib/cms";

const [salon, priceGroups, priceRules] = await Promise.all([
  getSalon(),
  getPriceGroups(),
  getPriceRules(),
]);
const booking = getBookingIntegration(salon);
---

<BaseLayout
  title="Preise"
  description="Preisübersicht für den fiktiven SalonFlow Kassel mit Schnitt, Farbe, Balayage und Event-Styling."
>
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">Preise</p>
      <h1 class="h1">Transparente Orientierung vor dem Termin.</h1>
      <p class="lead">
        Viele Salonpreise müssen mit "ab" arbeiten. Wichtig ist, dass Besucher
        trotzdem verstehen, in welcher Preisklasse sie sich bewegen.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Preisrechner</p>
      <h2 class="h2">Was es dich ungefähr kostet.</h2>
      <p class="lead">
        Wähle Leistung, Haarlänge und Extras. Der Rechner zeigt dir sofort einen
        Richtpreis, damit du vor dem Termin weißt, in welcher Größenordnung du
        dich bewegst.
      </p>
    </div>
  </section>
  <section class="section section-calc">
    <div class="container">
      <PriceCalculator rules={priceRules} bookingUrl="/termin/" />
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="list-head">
        <h2 class="h2">Alle Preise im Überblick</h2>
        <p class="lead">
          Die vollständige Liste ohne Rechner. Preise verstehen sich als
          Richtwerte ab dem genannten Betrag.
        </p>
      </div>
      <PriceList priceGroups={priceGroups} />
      <p class="hint">
        Alle Preise sind Platzhalter für ein Portfolio-Projekt. Rechtssichere
        Preisangaben müssen im echten Projekt mit dem Betrieb abgestimmt werden.
      </p>
    </div>
  </section>
  <BookingBand salon={salon} booking={booking} />
</BaseLayout>

<style>
  .page-hero {
    background: var(--dark);
    color: var(--ink-on-dark);
  }

  .page-hero .eyebrow {
    color: var(--gold);
  }

  .page-hero .lead {
    color: var(--muted-on-dark);
  }

  .section-calc {
    padding-top: 0;
  }

  .list-head {
    display: grid;
    gap: 14px;
    margin-bottom: 32px;
  }

  .hint {
    color: var(--muted);
    line-height: 1.6;
    margin-top: 24px;
  }
</style>
