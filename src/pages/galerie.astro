---
import BookingBand from "../components/BookingBand.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBookingIntegration, getGalleryItems, getSalon } from "../lib/cms";

const [salon, gallery] = await Promise.all([getSalon(), getGalleryItems()]);
const booking = getBookingIntegration(salon);
---

<BaseLayout
  title="Galerie"
  description="Galerie für SalonFlow Kassel mit neutralen Platzhalterbildern für Salon, Farbe und Styling."
>
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">Galerie</p>
      <h1 class="h1">Bilder entscheiden schneller als Absatze.</h1>
      <p class="lead">
        Für echte Kundenprojekte ist die Galerie oft der wichtigste Vertrauensbeweis.
        Dieses MVP zeigt die Struktur, nicht echte Salonarbeiten.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <GalleryGrid gallery={gallery} />
    </div>
  </section>
  <BookingBand salon={salon} booking={booking} />
</BaseLayout>

<style>
  .page-hero {
    background: var(--dark);
    color: var(--ink-on-dark);
  }

  .page-hero .eyebrow {
    color: var(--gold);
  }

  .page-hero .lead {
    color: var(--muted-on-dark);
  }
</style>
