---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Datenschutz"
  description="Datenschutz Platzhalter für das fiktive Portfolio-Projekt SalonFlow Kassel."
>
  <section class="section">
    <div class="container legal">
      <p class="eyebrow">Platzhalter</p>
      <h1 class="h1">Datenschutz</h1>
      <p>
        Diese Seite ist bewusst nur ein Platzhalter. Für echte Kundenprojekte in
        Deutschland müssen Tracking, Kontaktformulare, Karten, Buchungstools,
        Hosting und externe Dienste konkret beschrieben werden.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    max-width: 820px;
  }

  p {
    color: var(--muted);
    line-height: 1.7;
  }
</style>
