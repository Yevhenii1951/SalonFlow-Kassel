---
import BookingBand from "../components/BookingBand.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import Hero from "../components/Hero.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBookingIntegration, getGalleryItems, getSalon, getServices } from "../lib/cms";

const [salon, services, gallery] = await Promise.all([
  getSalon(),
  getServices(),
  getGalleryItems(),
]);
const booking = getBookingIntegration(salon);
const testimonials = [
  {
    text: "Sehr klare Beratung und ein Ergebnis, das auch nach Wochen noch gut aussieht.",
    name: "Sofie",
    rating: 5,
    date: "14.05.",
  },
  {
    text: "Online-Termin war schnell erledigt, Preise waren vorher verständlich.",
    name: "Jonas",
    rating: 5,
    date: "02.06.",
  },
  {
    text: "Ruhiger Salon, gute Empfehlungen und keine Hektik beim ersten Besuch.",
    name: "Meike",
    rating: 4,
    date: "21.06.",
  },
];
---

<BaseLayout
  title="Friseur Kassel"
  description="Fiktiver moderner Friseursalon in Kassel mit Balayage, Schnitt, Styling, Online-Termin und lokaler SEO-Struktur."
>
  <Hero salon={salon} bookingUrl="/termin/" />

  <section class="section">
    <div class="container intro-grid">
      <div>
        <p class="eyebrow">Leistungen</p>
        <h2 class="h2">Schnell verstehen, ob der Salon passt.</h2>
      </div>
      <p class="lead">
        Die Startseite priorisiert echte lokale Conversion: sichtbarer Terminbutton,
        klare Leistungsbereiche, Preisniveau, Vertrauen und Kontakt ohne Umwege.
      </p>
    </div>
    <div class="container section-tight">
      <ServiceGrid services={services} featuredOnly />
    </div>
  </section>

  <section class="section salon-section">
    <div class="container salon-grid">
      <figure class="salon-media">
        <img
          src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=1400&q=82"
          alt="Salonbereich mit gemütlicher Atmosphäre"
          loading="lazy"
        />
      </figure>
      <div class="salon-copy">
        <p class="eyebrow">Der Salon</p>
        <h2 class="h2">Ein Ort zum Wohlfühlen – mit klarer Beratung statt Hektik.</h2>
        <p class="lead">
          Der fiktive SalonFlow Kassel ist als Lern- und Präsentationsprojekt
          aufgebaut: Die Struktur zeigt, wie ein lokaler Salon Vertrauen,
          Service und eine schnelle Online-Buchung verbindet.
        </p>
        <ul class="salon-facts">
          <li><strong>Twelve stylistisch gestaltete Arbeitsplätze</strong><span>auf etwa 160 qm in heller, ruhiger Atmosphäre.</span></li>
          <li><strong>Beratung vor jeder Behandlung</strong><span>Ergebnis, Aufwand und Pflege werden offen geklärt.</span></li>
          <li><strong>Fokus auf die Praxis</strong><span>Diese Seite ist ein Schulungsprojekt – Inhalte sind Platzhalter.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section proof-section">
    <div class="container proof-grid">
      <div>
        <p class="eyebrow">Warum diese Struktur</p>
        <h2 class="h2">Gebaut wie ein Kundenprojekt, aber ohne echte Kundendaten.</h2>
      </div>
      <div class="proof-list">
        <article><strong>Mobile zuerst</strong><span>Booking und Telefon sind sofort erreichbar.</span></article>
        <article><strong>CMS-ready</strong><span>Services, Preise, Galerie, Team und FAQ liegen als strukturierte Content Collections vor.</span></article>
        <article><strong>Deutschland-ready</strong><span>Impressum, Datenschutz, lokale Keywords und Kontaktinformationen sind eingeplant.</span></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container intro-grid">
      <div>
        <p class="eyebrow">Galerie</p>
        <h2 class="h2">Visuelle Qualität vor langen Texten.</h2>
      </div>
      <p class="lead">
        Für echte Salons wären hier eigene Vorher/Nachher-Bilder wichtig. In diesem
        Lernprojekt nutzen wir neutrale Platzhalterbilder.
      </p>
    </div>
    <div class="container section-tight">
      <GalleryGrid gallery={gallery} />
    </div>
  </section>

  <section class="section testimonial-section">
    <div class="container">
      <p class="eyebrow">Vertrauen</p>
      <h2 class="h2">Kurze Signale statt leerer Werbetexte.</h2>
      <div class="grid-3 testimonial-grid">
        {testimonials.map((item) => (
          <blockquote class="card">
            <div class="stars" aria-label={`${item.rating} von 5 Sternen`}>
              {"★".repeat(item.rating)}
              <span>{"★".repeat(5 - item.rating)}</span>
            </div>
            <p>"{item.text}"</p>
            <footer>
              <strong>{item.name}</strong>
              <span>{item.date}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <BookingBand
    salon={salon}
    booking={booking}
    title={"Termin bei " + salon.name + " buchen"}
    text="Der wichtigste Button bleibt über die ganze Website hinweg sichtbar und führt in Phase 1 zu einem externen Booking-Link."
  />
</BaseLayout>

<style>
  .intro-grid,
  .proof-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 36px;
    align-items: start;
  }

  .proof-section {
    background: #f4efe6;
  }

  .proof-list {
    display: grid;
    gap: 14px;
  }

  .proof-list article {
    display: grid;
    gap: 6px;
    border-left: 4px solid var(--accent);
    background: rgba(255, 255, 255, 0.58);
    padding: 18px;
  }

  .salon-section {
    background: #fff;
  }

  .salon-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 40px;
    align-items: center;
  }

  .salon-media {
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
  }

  .salon-media img {
    width: 100%;
    height: 100%;
    min-height: 420px;
    object-fit: cover;
  }

  .salon-facts {
    display: grid;
    gap: 14px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .salon-facts li {
    display: grid;
    gap: 4px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .salon-facts span {
    color: var(--muted);
  }

  .proof-list span,
  blockquote {
    color: var(--muted);
  }

  .testimonial-section {
    background: #fff;
  }

  .testimonial-grid {
    margin-top: 28px;
  }

  blockquote {
    margin: 0;
    padding: 24px;
    line-height: 1.6;
  }

  .stars {
    margin-bottom: 12px;
    font-size: 1.05rem;
    letter-spacing: 0.15em;
    color: var(--accent);
  }

  .stars span {
    color: var(--line);
  }

  blockquote p {
    margin: 0 0 16px;
    font-size: 1.08rem;
    line-height: 1.55;
  }

  blockquote footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--muted);
    font-size: 0.88rem;
  }

  blockquote footer strong {
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .intro-grid,
    .proof-grid,
    .salon-grid {
      grid-template-columns: 1fr;
    }

    .salon-media img {
      min-height: 300px;
    }
  }
</style>
