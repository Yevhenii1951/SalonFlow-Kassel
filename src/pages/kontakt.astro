---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSalon } from "../lib/cms";

const salon = await getSalon();
---

<BaseLayout
  title="Kontakt"
  description="Kontakt, Adresse, Oeffnungszeiten und Terminbuchung für den fiktiven SalonFlow Kassel."
>
  <section class="section page-hero">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Kontakt</p>
        <h1 class="h1">Termin buchen oder direkt anrufen.</h1>
        <p class="lead">
          Kontaktdaten bleiben sichtbar, auch wenn eine Karte wegen Datenschutz
          erst nach Zustimmung geladen würde.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/termin/">Termin buchen</a>
          <a class="btn btn-secondary" href={"tel:" + salon.phone.replaceAll(" ", "")}>{salon.phone}</a>
        </div>
      </div>
      <aside class="card contact-card">
        <h2 class="h3">{salon.name}</h2>
        <p>
          {salon.address.street}<br />
          {salon.address.postalCode} {salon.address.city}
        </p>
        <p><a href={"mailto:" + salon.email}>{salon.email}</a></p>
        <div class="social-links">
          <p class="social-label">Social & payments</p>
          <p>
            <a href="https://www.instagram.com/salonflow-kassel" target="_blank" rel="noreferrer">Instagram</a>
            · <a href="https://www.facebook.com/salonflow-kassel" target="_blank" rel="noreferrer">Facebook</a>
            · <a href="https://paypal.me/salonflowkassel" target="_blank" rel="noreferrer">PayPal</a>
          </p>
          <p class="social-note">Platzhalter-Links für ein echtes Kundenprojekt.</p>
        </div>
        <ul>
          {salon.hours.map((item) => <li><span>{item.day}</span><strong>{item.time}</strong></li>)}
        </ul>
      </aside>
    </div>
  </section>

  {
    salon.coordinates ? (
      <section class="section">
        <div class="container">
          <div class="map-head">
            <p class="eyebrow">Karte</p>
            <h2 class="h2">So finden Sie uns in Kassel-Mitte.</h2>
            <p class="text-muted">{salon.address.street}, {salon.address.postalCode} {salon.address.city}</p>
          </div>
          <figure class="map-frame">
            <iframe
              title="SalonFlow Kassel auf der Karte"
              src={`https://www.openstreetmap.org/export/embed.html?bbox=${9.48188 - 0.006}%2C${51.31535 - 0.003}%2C${9.48188 + 0.006}%2C${51.31535 + 0.003}&layer=mapnik&marker=${salon.coordinates.lat}%2C${salon.coordinates.lon}`}
              loading="lazy"
            ></iframe>
            <figcaption>
              <a
                href={`https://www.openstreetmap.org/?mlat=${salon.coordinates.lat}&mlon=${salon.coordinates.lon}#map=17/${salon.coordinates.lat}/${salon.coordinates.lon}`}
                target="_blank"
                rel="noreferrer"
              >
                Größere Karte auf OpenStreetMap öffnen
              </a>
            </figcaption>
          </figure>
        </div>
      </section>
    ) : null
  }
</BaseLayout>

<style>
  .page-hero {
    background: var(--dark);
    color: var(--ink-on-dark);
  }

  .page-hero .eyebrow {
    color: var(--gold);
  }

  .page-hero .lead {
    color: var(--muted-on-dark);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 34px;
    align-items: start;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .contact-card {
    padding: 28px;
  }

  .contact-card p {
    color: var(--muted);
    line-height: 1.6;
  }

  .contact-card a {
    color: var(--accent-dark);
    font-weight: 600;
  }

  .social-links {
    margin-top: 18px;
    border-top: 1px dashed var(--line);
    padding-top: 14px;
  }

  .social-label {
    margin: 0 0 4px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .social-links p {
    margin: 4px 0;
  }

  .social-note {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .map-head {
    margin-bottom: 22px;
  }

  .map-head .text-muted {
    margin: 10px 0 0;
  }

  .map-frame {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
  }

  .map-frame iframe {
    display: block;
    width: 100%;
    height: 440px;
    border: 0;
  }

  .map-frame figcaption {
    padding: 12px 16px;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .map-frame a {
    color: var(--accent-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .map-frame a:hover {
    text-decoration: underline;
  }

  ul {
    display: grid;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--line);
    padding-top: 10px;
    color: var(--ink);
  }

  li strong {
    color: var(--ink);
    font-weight: 700;
  }

  .map-placeholder {
    border: 1px dashed var(--accent);
    border-radius: 8px;
    background: #fff;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
