---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Impressum"
  description="Impressum Platzhalter fuer das fiktive Portfolio-Projekt SalonFlow Kassel."
>
  <section class="section">
    <div class="container legal">
      <p class="eyebrow">Platzhalter</p>
      <h1 class="h1">Impressum</h1>
      <p>
        Dies ist ein Portfolio- und Lernprojekt. Fuer ein echtes deutsches
        Kundenprojekt muss das Impressum mit den realen Unternehmensdaten und ggf.
        juristischer Pruefung erstellt werden.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    max-width: 820px;
  }

  p {
    color: var(--muted);
    line-height: 1.7;
  }
</style>
