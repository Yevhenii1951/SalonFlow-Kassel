---
import BookingBand from "../components/BookingBand.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBookingIntegration, getFaqs, getSalon } from "../lib/cms";
import "../styles/faq.css";

const [salon, faqs] = await Promise.all([getSalon(), getFaqs()]);
const booking = getBookingIntegration(salon);
---

<BaseLayout
  title="FAQ"
  description="Häufige Fragen zu Terminbuchung, Preisen und Projektstatus von SalonFlow Kassel."
>
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">FAQ</p>
      <h1 class="h1">Fragen, die vor der Buchung entscheiden.</h1>
      <p class="lead">
        Was Besucher am häufigsten wissen wollen, bevor sie einen Termin buchen.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container faq-list">
      {
        faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>
              <span class="faq-question">{faq.question}</span>
              <span class="faq-category">{faq.category}</span>
              <span class="faq-icon" aria-hidden="true" />
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))
      }
      <p class="hint">
        Deine Frage ist nicht dabei? Ruf an oder schreib uns – wir antworten auch
        ohne Termin.
      </p>
    </div>
  </section>
  <BookingBand salon={salon} booking={booking} />
</BaseLayout>

<style>
  .page-hero {
    background: var(--dark);
    color: var(--ink-on-dark);
  }

  .page-hero .eyebrow {
    color: var(--gold);
  }

  .page-hero .lead {
    color: var(--muted-on-dark);
  }

  .faq-list {
    display: grid;
    gap: 12px;
    max-width: 820px;
  }

  .hint {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 8px 0 0;
  }
</style>
