---
import BookingBand from "../components/BookingBand.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBookingIntegration, getFaqs, getSalon } from "../lib/cms";

const [salon, faqs] = await Promise.all([getSalon(), getFaqs()]);
const booking = getBookingIntegration(salon);
---

<BaseLayout
  title="FAQ"
  description="Haeufige Fragen zu Terminbuchung, Preisen und Projektstatus von SalonFlow Kassel."
>
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">FAQ</p>
      <h1 class="h1">Fragen, die vor der Buchung entscheiden.</h1>
    </div>
  </section>
  <section class="section">
    <div class="container faq-list">
      {
        faqs.map((faq) => (
          <article class="card faq-item">
            <h2 class="h3">{faq.question}</h2>
            <p>{faq.answer}</p>
          </article>
        ))
      }
    </div>
  </section>
  <BookingBand salon={salon} booking={booking} />
</BaseLayout>

<style>
  .page-hero {
    background: var(--dark);
    color: var(--ink-on-dark);
  }

  .page-hero .eyebrow {
    color: var(--gold);
  }

  .page-hero .lead {
    color: var(--muted-on-dark);
  }

  .faq-list {
    display: grid;
    gap: 16px;
  }

  .faq-item {
    padding: 24px;
  }

  p {
    color: var(--muted);
    line-height: 1.6;
  }
</style>
