---
import "../styles/global.css";
import { getLocalBusinessSchema, getSalon } from "../lib/cms";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical = Astro.url.pathname } = Astro.props;
const salon = await getSalon();
const schema = getLocalBusinessSchema(salon, Astro.site?.origin ?? "https://salonflow-kassel.example");
const pageTitle = `${title} | ${salon.name}`;
const canonicalUrl = new URL(canonical, Astro.site).toString();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <SiteHeader name={salon.name} />
    <main>
      <slot />
    </main>
    <a class="btn btn-primary mobile-sticky-cta" href="/termin/">Termin buchen</a>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong>{salon.name}</strong>
          <p>{salon.tagline}</p>
        </div>
        <div>
          <strong>Kontakt</strong>
          <p>
            {salon.address.street}<br />
            {salon.address.postalCode} {salon.address.city}<br />
            <a href={`tel:${salon.phone.replaceAll(" ", "")}`}>{salon.phone}</a>
          </p>
        </div>
        <div>
          <strong>Rechtliches</strong>
          <p><a href="/impressum/">Impressum</a><br /><a href="/datenschutz/">Datenschutz</a><br /><a href="/agb/">AGB</a></p>
        </div>
      </div>
      <div class="container footer-credit">
        <p>Webentwicklung: Yevhenii Riabokon</p>
        <p>{salon.name} ist ein fiktives Portfolio-Projekt.</p>
      </div>
    </footer>
  </body>
</html>

<style>

  .site-footer {
    border-top: 1px solid var(--dark-line);
    background: var(--dark);
    color: var(--ink-on-dark);
    padding: 44px 0;
  }

  .site-footer p,
  .site-footer a {
    color: var(--muted-on-dark);
  }

  .site-footer strong {
    color: var(--ink-on-dark);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 28px;
  }

  .footer-credit {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 28px;
    border-top: 1px solid var(--dark-line);
    margin-top: 32px;
    padding-top: 22px;
  }

  .footer-credit p {
    font-size: 0.85rem;
  }

  @media (max-width: 620px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
